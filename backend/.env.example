
# Atlas example. URL-encode special characters in username/password, e.g. p@123 becomes p%40123.
MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/political_crm?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
PORT=5000
MAX_UPLOAD_MB=250
UPLOAD_TIMEOUT_MINUTES=30
# Local: uploads
# Render persistent disk recommended: /var/data/uploads
UPLOAD_PATH=uploads
CORS_ORIGIN=*

APP_PUBLIC_URL=http://localhost:5000
ALLOW_PUBLIC_REGISTER=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123 
# Windows local development paths. On Render/Linux, leave these unset or use:
# PDFIMAGES_PATH=pdfimages
# PDFTOPPM_PATH=pdftoppm
# TESSERACT_PATH=tesseract
# IMAGEMAGICK_PATH=magick
PDFIMAGES_PATH=C:\poppler-26.02.0\Library\bin\pdfimages.exe
PDFTOPPM_PATH=C:\poppler-26.02.0\Library\bin\pdftoppm.exe
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=.\tessdata
IMAGEMAGICK_PATH=C:\Program Files\ImageMagick-7.1.1-Q16-HDRI\magick.exe
OCR_LANGUAGES=hin+eng
OCR_DPI=300
OCR_PSM=6
VOTER_GRID_COLUMNS=3
VOTER_GRID_ROWS=10
VOTER_GRID_LEFT_RATIO=0.02
VOTER_GRID_HEADER_RATIO=0.03
VOTER_GRID_CARD_WIDTH_RATIO=0.288
VOTER_GRID_CARD_HEIGHT_RATIO=0.088
VOTER_GRID_GAP_X_RATIO=0.006
VOTER_GRID_GAP_Y_RATIO=0.005
VOTER_GRID_FOOTER_RATIO=0.025
VOTER_PHOTO_LEFT_RATIO=0.70
VOTER_PHOTO_TOP_RATIO=0.25
VOTER_PHOTO_WIDTH_RATIO=0.29
VOTER_PHOTO_HEIGHT_RATIO=0.63
VOTER_PAGE_MIN_LABELS=5
VOTER_CELL_OCR_PSM=6
OCR_CELL_CONCURRENCY=4
IMAGE_CROP_CONCURRENCY=6
OCR_PAGE_CONCURRENCY=1
OCR_CARD_FALLBACKS_PER_PAGE=1
OCR_DEEP_RETRY=false
# VPS accuracy mode: dual fixed-region OCR for every critical voter field.
OCR_VERIFY_ALL_FIELDS=false
OMP_THREAD_LIMIT=1
OCR_CARD_WIDTH=1350
OCR_THRESHOLD=68
USE_PYTHON_OCR=true
PYTHON_PATH=python
OCR_MIN_CONFIDENCE=85
# Optional for extracting voter photos from PDFs. Install Poppler and set full path if not in PATH.
# PDFIMAGES_PATH=C:\poppler\Library\bin\pdfimages.exe

# WhatsApp Business Cloud API (token server environment में रखें, UI/database में नहीं)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0

WHATSAPP_SESSION_PATH=./whatsapp-sessions
# Optional: installed Chrome/Chromium executable path
CHROME_PATH=



# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
